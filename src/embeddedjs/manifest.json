{
	"config": {
		"icon": "./icon.png",
		"watchface": true
	},
	"creation": {
		"static": 32768,
		"chunk": {
			"initial": 14336
		},
		"heap": {
			"initial": 768
		},
		"stack": 384
	},
	"modules": {
		"*": "./main"
	},
	"platforms": {
		"*/emery": {
			"modules": {
				"*": "./emery/layout"
			},
			"resources": {
				"*-alpha": [ "./assets/large_digits_40", "./assets/months", "./assets/days", "./assets/small_digits", "./assets/labels"],
        "*": ["./assets/indicator"]
			}
		},
		"...": {
			"error": "Platform not supported"
		}
	},
	"include": [
		"$(MODDABLE)/examples/manifest_mod.json",
		"$(MODDABLE)/examples/manifest_typings.json"
	]
}
